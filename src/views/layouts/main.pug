doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title= typeof title !== "undefined" ? title : "Movie App"

        //- Hoja de estilos principal
        link(rel="stylesheet" href="/css/base.css")
        link(rel="stylesheet" href="/css/layouts/main.css")
        block styles

    body
        //- Cabecera de la aplicación
        header
            a.brand-title(href="/") Movie App

            if typeof user !== "undefined" && user
                //- Navegación del administrador
                if user.role === "admin"
                    details
                        summary
                            span ☰
                            |  Menú
                        nav
                            ul
                                li
                                    a(href="/movies") Películas
                                li
                                    a(href="/users") Usuarios
                                li
                                    a(href="/api/auth/logout") Salir

                //- Navegación del usuario
                else
                    details
                        summary
                            span ☰
                            |  Menú
                        nav
                            ul
                                li
                                    a(href="/dashboard") Panel de control
                                li
                                    a(href="/search") Buscar películas
                                li
                                    a(href="/movies") Mis favoritos
                                li
                                    a(href="/api/auth/logout") Salir

            //- Navegación para visitantes no autenticados (solo los 3 accesos)
            else
                nav.auth-actions(aria-label="Acceso de usuario")
                    a.nav-btn.nav-btn--login(href="/login") Iniciar sesión
                    a.nav-btn.nav-btn--signup(href="/signup") Registrarse
                    a.nav-btn.nav-btn--google(href="/api/auth/google") Continuar con Google

        main
            block content

    footer
        p ~ Proyecto Backend ~
    //- Scripts específicos de cada vista
    block scripts
    script(src="/js/favorites.js" defer)