
doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title= typeof title !== "undefined" ? title : "Movie App"

        //- Hoja de estilos principal
        link(rel="stylesheet" href="/css/styles.css")

    body
        //- Cabecera de la aplicación
        header
            h1 Movie App

        //- Comprobamos si existe un usuario autenticado
        if typeof user !== "undefined" && user

            //- Navegación del administrador
            if user.role === "Admin"
                details.sidebar-menu
                    summary.menu-toggle
                        span ☰
                        |  Menú

                    nav.admin-nav
                        ul
                            li
                                a(href="/movies") Gestión de películas
                            li
                                a(href="/users") Gestión de usuarios
                            li
                                a(href="/profile") Mi perfil
                            li
                                form(action="/api/logout" method="POST")
                                    button(type="submit") Cerrar sesión

            //- Navegación del usuario
            else
                details.sidebar-menu
                    summary.menu-toggle
                        span ☰
                        |  Menú

                    nav.user-nav
                        ul
                            li
                                a(href="/dashboard") Panel de control
                            li
                                a(href="/search") Buscar películas
                            li
                                a(href="/movies") Mis películas
                            li
                                form(action="/api/logout" method="POST")
                                    button(type="submit") Cerrar sesión

        //- Navegación para visitantes no autenticados
        else
            nav.public-nav
                ul
                    li
                        a(href="/") Inicio
                    li
                        a(href="/login") Iniciar sesión
                    li
                        a(href="/signup") Registrarse

        //- Contenido específico de cada página
        main
            block content

        //- Pie de página
        footer
            p Movie App - Proyecto Backend
