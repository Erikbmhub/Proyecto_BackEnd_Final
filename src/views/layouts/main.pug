
doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title= typeof title !== "undefined" ? title : "Movie App"

        //- Hoja de estilos principal
        link(rel="stylesheet" href="/css/styles.css")

    body
        //- Cabecera de la aplicación
        header
            h1 Movie app / Vista de inicio
            //- La vista principal muestra el acceso; las demás vistas sustituyen este bloque.

            //- Comprobamos si existe un usuario autenticado
            if typeof user !== "undefined" && user

                //- Navegación del administrador
                if user.role === "admin"
                    details
                        summary
                            span ☰
                            |  Menú
                        nav
                            ul
                                li
                                    form(action="/api/logout" method="POST")
                                        button(type="submit") Salir

                //- Navegación del usuario
                else
                    details
                        summary
                            span ☰
                            |  Menú

                        nav
                            ul
                                li
                                    a(href="/dashboard") Panel de control
                                li
                                    a(href="/search") Buscar películas
                                li
                                    a(href="/movies") Mis favoritos
                                li
                                    form(action="/api/logout" method="POST")
                                        button(type="submit") Salir


            //- Navegación para visitantes no autenticados
            else


                section
                    h2 Iniciar sesión

                    form(action="/api/login" method="POST")
                        div
                            label(for="email") Correo electrónico
                            input(
                                type="email"
                                name="email"
                                placeholder="Introduce tu correo electrónico"
                                autocomplete="email"
                                required
                            )

                        div
                            label(for="password") Contraseña
                            input(
                                type="password"
                                name="password"
                                placeholder="Introduce tu contraseña"
                                autocomplete="current-password"
                                required
                            )

                        button(type="submit") Iniciar sesión

                    div
                        p O continúa con tu cuenta de Google:
                        a(href="/auth/google") Continuar con Google

                    p
                        | ¿Todavía no tienes cuenta? 
                        a(href="/signup") Regístrate aquí

        main
            block content

    footer
        p ~ Proyecto Backend ~