extends ../layouts/main

block styles
  link(rel=“stylesheet” href=“/css/user/detail.css”)

block content
    section
        //- Título de la película
        h2= movie.Title

        //- Información principal
        div
            //- Cartel de la película
            div
                img(
                    src=movie.Poster
                    alt="Portada de " + movie.Title
                )

            //- Información de la película
            div
                h4= movie.Title
                p Año: #{movie.Year}
                p Director: #{movie.Director}
                p Género: #{movie.Genre}
                p Duración: #{movie.Runtime}
                p Sinopsis: #{movie.Plot}
                p Reparto: #{movie.Actors}
                p Valoración: #{movie.imdbRating}

        //- Acciones de la película
        div
            button(
                type="button"
                class="add-favorite"
                data-movie-id=movie.id
                data-movie-source=movie.source
            ) Añadir a favoritos

            a(href="/search") Buscar más películas