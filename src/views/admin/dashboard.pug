extends ../layouts/main

block styles
  link(rel="stylesheet" href="/css/admin/dashboard.css")

block content
    section.admin-dashboard-container
        //- Encabezado de bienvenida del administrador
        div.admin-welcome
            h2 Panel de administración
            p Gestiona el catálogo de películas y los usuarios registrados de la plataforma.

        //- Accesos principales del administrador
        section.admin-options
            h3 Gestión principal

            div.admin-cards
                //- Gestión de películas
                article.admin-card
                    h4 Gestión de películas
                    p Crea, edita o elimina películas del catálogo.
                    a(href="/movies") Ir a películas

                //- Gestión de usuarios
                article.admin-card
                    h4 Gestión de usuarios
                    p Consulta, crea, edita o elimina cuentas de usuario.
                    a(href="/users") Ir a usuarios

                //- Perfil del administrador
                article.admin-card
                    h4 Mi perfil
                    p Revisa o actualiza los datos de tu cuenta.
                    a(href="/profile") Ir a mi perfil