
block styles
    link(rel="stylesheet" href="/css/admin/users.css")

block content
    section.admin-users-container
        div.admin-users-header
            h2 Gestión de usuarios
            a(href="/movies") Volver a gestión de películas

        //- Formulario para crear un usuario
        section.create-user
            h3 Crear nuevo usuario

            form#user-form
                div.form-group
                    label(for="username") Nombre
                    input#username(
                        type="text"
                        name="username"
                        placeholder="Nombre del usuario"
                        required
                    )

                div.form-group
                    label(for="email") Correo electrónico
                    input#email(
                        type="email"
                        name="email"
                        placeholder="Correo electrónico"
                        required
                    )

                div.form-group
                    label(for="password") Contraseña
                    input#password(
                        type="password"
                        name="password"
                        placeholder="Contraseña"
                        required
                    )
                //- Confirmación de contraseña
                div.form-group
                    label(for="confirmPassword") Confirmar contraseña
                    input(
                        type="password"
                        name="confirmPassword"
                        placeholder="Repite tu contraseña"
                        required
                    )

                button(type="submit") Crear usuario

        //- Formulario para editar un usuario
        section.edit-user-form
            h3 Editar usuario

            form#edit-user-form
                input#edit-user-id(
                    type="hidden"
                    name="id"
                )

                div.form-group
                    label(for="edit-username") Nombre
                    input#edit-username(
                        type="text"
                        name="username"
                        required
                    )

                div.form-group
                    label(for="edit-email") Correo electrónico
                    input#edit-email(
                        type="email"
                        name="email"
                        required
                    )

                div.form-group
                    label(for="edit-role") Rol
                    select#edit-role(
                        name="role"
                        required
                    )
                        option(value="user") Usuario
                        option(value="admin") Administrador

                button(type="submit") Guardar cambios
                button#cancel-edit(type="button") Cancelar

        //- Listado de usuarios registrados
        section.user-management
            h3 Usuarios registrados

            if users && users.length
                table
                    thead
                        tr
                            th ID
                            th Usuario
                            th Correo electrónico
                            th Rol
                            th Fecha de registro
                            th Acciones

                    tbody
                        each user in users
                            tr(data-user-id=user.id)
                                td= user.id
                                td= user.username
                                td= user.email
                                td= user.role
                                td= new Date(user.created_at).toLocaleDateString("es-ES")
                                td
                                    button(
                                        type="button"
                                        class="edit-user"
                                        data-user-id=user.id
                                    ) Editar

                                    button(
                                        type="button"
                                        class="delete-user"
                                        data-user-id=user.id
                                    ) Eliminar
            else
                p Todavía no hay usuarios registrados.

block scripts
    script(src="/js/users.js" defer)
